{
    "name": "3neti/x-stamp",
    "description": "Portable versioned Stamp documents, validation, and HTML/SVG/PNG rendering.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "opis/json-schema": "^2.6"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.0",
        "spatie/browsershot": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "LBHurtado\\XStamp\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest --compact",
        "format": "pint --format agent"
    },
    "suggest": {
        "spatie/browsershot": "^5.4 enables optional browser and browser-hd rendering (requires Node and Puppeteer)."
    }
}
