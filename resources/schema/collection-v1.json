{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "id",
        "designs",
        "files"
    ],
    "properties": {
        "schema": {
            "const": "x-stamp-collection/1"
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        },
        "designs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "maxLength": 200
            }
        },
        "files": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1000,
            "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
            }
        },
        "thumbnails": {
            "type": "object",
            "additionalProperties": {
                "type": "string",
                "maxLength": 200
            }
        },
        "retired_designs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
            }
        }
    }
}
