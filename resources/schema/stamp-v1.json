{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "id",
        "revision",
        "name",
        "width",
        "height",
        "background",
        "foreground",
        "font",
        "layers"
    ],
    "properties": {
        "schema": {
            "const": "x-stamp/1"
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "revision": {
            "type": "integer",
            "minimum": 1
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
        },
        "width": {
            "type": "integer",
            "minimum": 320,
            "maximum": 2400
        },
        "height": {
            "type": "integer",
            "minimum": 200,
            "maximum": 1600
        },
        "background": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "foreground": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "font": {
            "type": "string",
            "maxLength": 200
        },
        "layers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "type",
                    "x",
                    "y",
                    "width",
                    "height",
                    "color"
                ],
                "properties": {
                    "type": {
                        "enum": [
                            "rectangle",
                            "circle",
                            "line",
                            "text",
                            "image"
                        ]
                    },
                    "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 4096
                    },
                    "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 4096
                    },
                    "width": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 4096
                    },
                    "height": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 4096
                    },
                    "color": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "radius": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 4096
                    },
                    "text": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "slot": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    },
                    "asset": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "size": {
                        "type": "number",
                        "minimum": 8,
                        "maximum": 160
                    },
                    "max_lines": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                    },
                    "fit": {
                        "enum": [
                            "stretch",
                            "cover",
                            "contain"
                        ]
                    },
                    "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                    },
                    "anchor": {
                        "enum": [
                            "top",
                            "center",
                            "bottom"
                        ]
                    }
                }
            }
        },
        "customization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "controls",
                "defaults",
                "artwork_layer"
            ],
            "properties": {
                "controls": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "crop",
                            "darkening",
                            "tagline",
                            "qr"
                        ]
                    }
                },
                "defaults": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "preset": {
                            "enum": [
                                "clear",
                                "soft",
                                "transparent"
                            ]
                        },
                        "crop": {
                            "enum": [
                                "top",
                                "center",
                                "bottom"
                            ]
                        },
                        "darkening": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 40
                        },
                        "show_tagline": {
                            "type": "boolean"
                        }
                    }
                },
                "artwork_layer": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99
                }
            }
        }
    }
}
